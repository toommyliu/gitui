{
  "name": "gitui-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "effect-tsgo patch --typescript --oxlint && git config core.hooksPath .githooks",
    "test": "turbo test",
    "check": "oxfmt --check && oxlint --deny-warnings && turbo typecheck test",
    "serve": "pnpm -F web build && pnpm -F server start",
    "desktop": "turbo run build --filter=desktop && pnpm -F desktop start"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module"
}
