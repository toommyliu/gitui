{
  "name": "@gitui/monorepo",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "vp run -r build",
    "dev": "node scripts/dev.ts --filter=@gitui/web --filter=@gitui/server",
    "dev:desktop": "node scripts/dev.ts --filter=@gitui/web --filter=@gitui/desktop",
    "package:desktop": "vp run @gitui/desktop#package",
    "typecheck": "vp run -r typecheck",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "test": "vp run -r test",
    "bench": "pnpm -F @gitui/server bench",
    "check": "vp fmt --check && vp lint --deny-warnings && vp run -r typecheck && vp run -r test",
    "serve": "pnpm -F @gitui/web build && pnpm -F @gitui/server start",
    "serve:desktop": "pnpm -F @gitui/web build && pnpm -F @gitui/desktop build && pnpm -F @gitui/desktop start"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module"
}
